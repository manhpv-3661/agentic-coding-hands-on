# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Homepage event countdown (ISO-8601, include an explicit UTC offset to avoid
# local-timezone ambiguity). Missing/invalid -> countdown shows 00 00 00 and
# "Coming soon" is hidden (see lib/event-countdown.ts). Also drives the
# site-wide Prelaunch time-gate in proxy.ts (same moment unlocks both).
NEXT_PUBLIC_EVENT_START_AT=2025-12-31T18:30:00+07:00
